#include <iostream>
#include <cmath> // For pow() function
using namespace std;

int isArmstrong(int number) {
    // Store the original number to compare at the end
    int originalNumber = number;
    
    // Find the number of digits in the number
    int numDigits = 0;
    while (number > 0) {
        number /= 10;
        numDigits++;
    }
    
    // Restore the original number
    number = originalNumber;
    
    int sumOfPowers = 0;
    while (number > 0) {
        int digit = number % 10; // Get the last digit
        sumOfPowers += pow(digit, numDigits); // Add digit raised to the power of numDigits
        number /= 10; // Remove the last digit
    }
    
    // Return true if the sum equals the original number, false otherwise
    return sumOfPowers ;
}

int main() {
    int number;
    cout << "Enter a number: ";
    cin >> number;
    cout<<endl;
    cout<<isArmstrong(number);
    return 0;
}